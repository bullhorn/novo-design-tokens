{
  "borderWidth": {
    "none": {
      "$value": "0"
    },
    "thin": {
      "$value": "1px"
    },
    "thick": {
      "$value": "2px"
    }
  },
  "borderRadius": {
    "xxsm": {
      "$value": "0.1rem"
    },
    "xsm": {
      "$value": "0.2rem"
    },
    "sm": {
      "$value": "0.3rem"
    },
    "md": {
      "$value": "0.4rem"
    },
    "lg": {
      "$value": "0.6rem"
    },
    "xl": {
      "$value": "0.8rem"
    },
    "round": {
      "$value": "0.4rem"
    },
    "square": {
      "$value": "0rem"
    },
    "circle": {
      "$value": 99999
    },
    "default": {
      "$value": "{borderRadius.round}"
    }
  },
  "divider": {
    "insetMargin": {
      "$value": "80px"
    }
  }
}
