{
  "name": "novo-design-tokens",
  "version": "0.1.4",
  "description": "Design tokens for the Novo Design System",
  "homepage": "https://github.com/bullhorn/novo-design-tokens#readme",
  "license": "MIT",
  "main": "lib/variables.js",
  "module": "lib/variables.esm.js",
  "exports": {
    ".": {
      "import": "./lib/variables.esm.js",
      "require": "./lib/variables.js",
      "default": "./lib/variables.js"
    },
    "./scss": "./scss/_index.scss",
    "./scss/*": "./scss/*",
    "./css/*": "./css/*",
    "./css/variables": "./css/variables.css",
    "./css/variables.min": "./css/variables.min.css",
    "./css/variables-dark": "./css/variables-dark.css",
    "./css/variables-dark.min": "./css/variables-dark.min.css",
    "./lib/*": "./lib/*"
  },
  "files": [
    "lib",
    "css",
    "scss"
  ],
  "scripts": {
    "build": "node build.mjs",
    "postbuild": "npm run postcss && npm run minifycss",
    "clean": "rm -rf build",
    "prepublishOnly": "npm run build && npm run minifycss",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postcss": "postcss ./css/*.css --use autoprefixer -d css/ --no-map",
    "minifycss": "foreach -g \"css/**/*.css\" -i \"css/**/*.min.css\" -t 10 -x \"npx cleancss -o #{dir}/#{name}.min.css #{path}\""
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "autoprefixer": "^10.5.0",
    "chroma-js": "^2.4.2",
    "clean-css-cli": "^5.6.3",
    "foreach-cli": "1.8.1",
    "handlebars": "^4.7.9",
    "loggy": "^1.0.8",
    "mini-svg-data-uri": "^1.4.4",
    "polished": "^4.3.1",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "sass": "^1.100.0",
    "semantic-release": "^24.2.9",
    "style-dictionary": "^5.4.1"
  },
  "browserslist": [
    "> 1%",
    "last 4 versions",
    "not dead"
  ]
}
